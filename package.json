  "types": "dist/esm/index.d.ts",
  "type": "module",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Plugin/",
    "CapacitorTts.podspec"
  ],
